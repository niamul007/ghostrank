# Copy this file to .env and fill in the values.
# Never commit .env to git — it contains secrets.

# Neon POOLED connection string (host contains "-pooler"). Used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Neon DIRECT (non-pooled) connection string. Used by Prisma migrations.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DBNAME?sslmode=require"
# Secret key used to sign JWT access tokens.
# Must be at least 32 characters (the server refuses to start otherwise).
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ACCESS_TOKEN_SECRET=ghostrank-secret-token

# Port the Express server listens on. Defaults to 4000 if unset.
PORT=4000

# API keys for the AI scanner (src/scanner/aiQuerier.ts).
# Scans for a platform fail (with a startup warning) if its key is missing.
# ChatGPT / Perplexity / Gemini calls are paused for now — testing Claude only.
# OPENAI_API_KEY=
# PERPLEXITY_API_KEY=
# GEMINI_API_KEY=

# Anthropic (Claude) API key — used by queryClaude() in aiQuerier.ts.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional: Claude model id. Defaults to claude-sonnet-5-5. Valid values include claude-sonnet-5-5, claude-haiku-5-5 and claude-opus-5-5.
# ANTHROPIC_MODEL=claude-sonnet-5-5
