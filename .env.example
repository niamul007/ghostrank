# Copy this file to .env and fill in the values.
# Never commit .env to git — it contains secrets.

# Local Docker Postgres connection string.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# With Docker Compose running, host is "localhost" and port is 5432
# (mapped from the container by the ports: "5432:5432" setting).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mydb"

# Secret key used to sign JWT access tokens.
# Use a long random string in production — e.g. output of:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
ACCESS_TOKEN_SECRET=

# Port the Express server listens on. Defaults to 4000 if unset.
PORT=4000

# API keys for the AI scanner (src/scanner/aiQuerier.ts).
# Scans for a platform fail (with a startup warning) if its key is missing.
# ChatGPT / Perplexity / Gemini calls are paused for now — testing Claude only.
# OPENAI_API_KEY=
# PERPLEXITY_API_KEY=
# GEMINI_API_KEY=

# Anthropic (Claude) API key — used by queryClaude() in aiQuerier.ts.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
