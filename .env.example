# Copy this file to .env and fill in the values.
# Never commit .env to git — it contains secrets.

# Neon POOLED connection string (host contains "-pooler"). Used by the app at runtime.
DATABASE_URL=postgresql://neondb_owner:npg_fY4dvDbL8XVP@ep-muddy-wind-azidbq22-pooler.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Neon DIRECT (non-pooled) connection string. Used by Prisma migrations.
DIRECT_URL=postgresql://neondb_owner:npg_fY4dvDbL8XVP@ep-muddy-wind-azidbq22.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# Secret key used to sign JWT access tokens.
# Use a long random string in production — e.g. output of:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
ACCESS_TOKEN_SECRET=ghostrank-secret-token

# Port the Express server listens on. Defaults to 4000 if unset.
PORT=4000

# API keys for the AI scanner (src/scanner/aiQuerier.ts).
# Scans for a platform fail (with a startup warning) if its key is missing.
# ChatGPT / Perplexity / Gemini calls are paused for now — testing Claude only.
# OPENAI_API_KEY=
# PERPLEXITY_API_KEY=
# GEMINI_API_KEY=

# Anthropic (Claude) API key — used by queryClaude() in aiQuerier.ts.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
